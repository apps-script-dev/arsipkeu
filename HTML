// 1. Fungsi untuk pindah-pindah form Login/Register
function toggleAuth(isRegister) {
  const loginForm = document.getElementById('loginForm');
  const registerForm = document.getElementById('registerForm');
  const sideTitle = document.getElementById('sideTitle');
  const sideDesc = document.getElementById('sideDesc');

  if (isRegister) {
    loginForm.classList.add('d-none');
    registerForm.classList.remove('d-none');
    sideTitle.innerText = "Buat akun anda!";
    sideDesc.innerText = "Buat akun untuk mulai mengelola dokumen digital Anda dengan lebih efisien.";
  } else {
    registerForm.classList.add('d-none');
    loginForm.classList.remove('d-none');
    sideTitle.innerText = "Selamat datang!";
    sideDesc.innerText = "Anda dapat masuk untuk mengaksesnya menggunakan akun Anda yang sudah ada.";
  }
}

// 2. Fungsi untuk proses Registrasi
function doRegister() {
  // 1. Ambil nilai input
  const fullNameEl = document.getElementById('regFullName');
  const emailEl = document.getElementById('regEmail');
  const userEl = document.getElementById('regUser');
  const passEl = document.getElementById('regPass');
  const btn = document.getElementById('btnReg');

  const fullName = fullNameEl ? fullNameEl.value.trim() : "";
  const email = emailEl ? emailEl.value.trim().toLowerCase() : "";
  const username = userEl ? userEl.value.trim() : "";
  const password = passEl ? passEl.value : "";

  // 2. Validasi Kelengkapan (Efek Getar)
  if (!fullName || !email || !username || !password) {
    return Swal.fire({
      title: 'Data Tidak Lengkap',
      text: 'Harap lengkapi semua kolom pendaftaran untuk melanjutkan.',
      iconHtml: '<i class="bi bi-exclamation-circle-fill text-warning" style="font-size: 3rem;"></i>',
      confirmButtonText: 'LENGKAPI',
      confirmButtonColor: '#7c3aed',
      showClass: { popup: 'animate__animated animate__shakeX' },
      customClass: { icon: 'border-0' }
    });
  }

  // 3. Validasi Khusus Email Google (@gmail.com)
  if (!email.endsWith('@gmail.com')) {
    return Swal.fire({
      title: 'Email Ditolak',
      text: 'Pendaftaran hanya diizinkan menggunakan alamat @gmail.com.',
      iconHtml: '<i class="bi bi-envelope-x-fill text-danger" style="font-size: 3rem;"></i>',
      confirmButtonText: 'PERBAIKI EMAIL',
      confirmButtonColor: '#ef4444',
      customClass: { icon: 'border-0' }
    });
  }

  // 4. Feedback Visual pada Tombol
  btn.disabled = true;
  btn.innerHTML = `<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                   <span style="color: white !important; margin-left: 8px;">MEMPROSES...</span>`;

  // 5. Popup Loading Mewah
  Swal.fire({
    title: 'Membuat Akun',
    text: 'Sistem sedang membuat akun anda',
    allowOutsideClick: false,
    showConfirmButton: false, // WAJIB FALSE
    showCancelButton: false,  // WAJIB FALSE
    didOpen: () => {
      Swal.showLoading();
    }
  });

  const userData = {
    fullName: fullName,
    email: email,
    username: username,
    password: password
  };

  // 6. Kirim ke Backend
  google.script.run.withSuccessHandler(res => {
    Swal.close();
    btn.disabled = false;
    btn.innerText = 'CREATE ACCOUNT';

    if (res.success) {
      // --- POPUP REGISTRASI BERHASIL ---
      Swal.fire({
        title: 'Pendaftaran Berhasil!',
        text: res.msg,
        iconHtml: '<i class="bi bi-check-lg"></i>',
        confirmButtonText: 'MASUK SEKARANG',
        
        showConfirmButton: false,
        timer: 4000,
        timerProgressBar: true,
        customClass: {
                icon: 'border-success' }
      }).then(() => {
        // Bersihkan Form
        if (fullNameEl) fullNameEl.value = "";
        if (emailEl) emailEl.value = "";
        if (userEl) userEl.value = "";
        if (passEl) passEl.value = "";
        
        // Alihkan ke halaman login
        if (typeof toggleAuth === 'function') {
          toggleAuth(false);
        }
      });
    } else {
      // --- POPUP REGISTRASI GAGAL (Username/Email sudah ada) ---
      Swal.fire({
        title: 'Gagal Daftar',
        text: res.msg,
        iconHtml: '<i class="bi bi-x-circle-fill text-danger" style="font-size: 3rem;"></i>',
        confirmButtonText: 'PERBAIKI',
        confirmButtonColor: '#ef4444',
        customClass: { icon: 'border-0' }
      });
    }
  }).registerUser(userData);
}

