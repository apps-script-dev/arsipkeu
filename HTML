    // --- 1. SESSION MANAGEMENT (ANTI-BLANK & ANTI-STUCK) ---
document.addEventListener("DOMContentLoaded", function() {
  console.log("Memulai Inisialisasi...");

  // 1. Ambil Token dengan cara yang aman dari error syntax
  // Kita bungkus dalam tanda kutip untuk memastikan dia selalu dianggap string
  const tokenFromServer = "<?= token ?>"; 
  const urlParams = new URLSearchParams(window.location.search);
  const tokenFromUrl = urlParams.get('token');
  
  // Tentukan token yang aktif (prioritas dari URL browser)
  const activeToken = (tokenFromUrl && tokenFromUrl !== "") ? tokenFromUrl : tokenFromServer;

  // 2. Inisialisasi Dasar (Gunakan try-catch agar jika satu gagal, loading tetap hilang)
  try {
    const inputDate = document.getElementById('inputDate');
    if (inputDate) inputDate.valueAsDate = new Date();
    
    if (typeof initSelect2 === 'function') initSelect2();
    if (typeof setupDragAndDrop === 'function') setupDragAndDrop();
    if (typeof setupActivityListeners === 'function') setupActivityListeners();
  } catch(err) {
    console.warn("Inisialisasi komponen tertunda:", err);
  }

  // 3. LOGIKA REDIRECT (Token vs Session)
  if (activeToken && activeToken !== "null" && activeToken !== "") {
    console.log("Mode Reset Password Aktif.");
    stopLoader(); // MATIKAN LOADING
    if (typeof showResetPasswordForm === 'function') {
      showResetPasswordForm(activeToken);
    }
  } else {
    console.log("Mode Normal Aktif.");
    
    // Auto-fill 'Remember Me'
    const remUser = localStorage.getItem('remembered_username');
    const remPass = localStorage.getItem('remembered_password');
    if (remUser && remPass) {
      if($('#user').length) $('#user').val(remUser);
      if($('#pass').length) $('#pass').val(remPass);
      if($('#remember').length) $('#remember').prop('checked', true);
    }

    // Cek Sesi Login
    const session = localStorage.getItem('archive_session');
    if (session) {
      try {
        showAppUI(JSON.parse(session));
      } catch(e) {
        localStorage.removeItem('archive_session');
        showLoginUI();
      }
    } else {
      showLoginUI();
    }
  }

  // 4. FAILSING SAFE: Matikan loader otomatis setelah 2.5 detik jika masih menggantung
  setTimeout(stopLoader, 2500);
});

// Pastikan fungsi stopLoader tersedia
function stopLoader() {
  const loader = document.getElementById('loadingOverlay');
  if (loader) loader.style.display = 'none';
}


function showResetPasswordForm(token) {
  // 1. Siapkan UI Latar Belakang
  const loginPage = document.getElementById('loginPage');
  const appPage = document.getElementById('appPage');
  const loginForm = document.getElementById('loginForm');
  const registerForm = document.getElementById('registerForm');

  if (appPage) appPage.style.display = 'none';
  if (loginPage) loginPage.style.display = 'flex';
  
  // Sembunyikan form input agar fokus ke popup ganti password
  if (loginForm) loginForm.classList.add('d-none');
  if (registerForm) registerForm.classList.add('d-none');

  // 2. Tampilkan Popup Ganti Password Mewah
  Swal.fire({
    title: 'Keamanan Akun',
    text: 'Silakan tentukan password baru untuk akun Anda (minimal 5 karakter).',
    input: 'password',
    inputPlaceholder: 'Ketik password baru...',
    inputAttributes: {
      autocapitalize: 'off',
      autocorrect: 'off'
    },
    showCancelButton: true,
    confirmButtonText: 'SIMPAN PASSWORD',
    cancelButtonText: 'BATAL',
    confirmButtonColor: '#7c3aed',
    cancelButtonColor: '#94a3b8',
    reverseButtons: true,
    allowOutsideClick: false,
    showLoaderOnConfirm: true,
    preConfirm: (newPass) => {
      if (!newPass || newPass.length < 5) {
        return Swal.showValidationMessage('Password terlalu pendek! Gunakan minimal 5 karakter.');
      }
      return new Promise((resolve) => {
        google.script.run
          .withSuccessHandler(res => resolve(res))
          .withFailureHandler(err => {
             Swal.showValidationMessage('Gagal terhubung ke server. Coba lagi.');
             resolve(null);
          })
          .finalizeResetPassword(token, newPass);
      });
    },
    customClass: {
      confirmButton: 'shadow-sm',
      cancelButton: 'shadow-sm'
    }
  }).then((result) => {
    // 3. LOGIKA SETELAH KLIK SIMPAN / BATAL
    if (result.isConfirmed && result.value) {
      if (result.value.success) {
        // --- JIKA BERHASIL ---
        Swal.fire({
          title: 'Berhasil!',
          text: result.value.msg,
          iconHtml: '<i class="bi bi-check-lg text-success" style="font-size: 3rem;"></i>',
          timer: 2500,
          showConfirmButton: false,
          timerProgressBar: true,
          customClass: { icon: 'border-success', popup: 'no-btn' }
        }).then(() => {
          // Bersihkan URL dari token agar tidak terjebak di mode reset
          if (window.history.replaceState) {
            const cleanUrl = window.location.origin + window.location.pathname;
            window.history.replaceState({}, document.title, cleanUrl);
          }
          // Tampilkan kembali form login (Solusi Anti-Blank)
          showLoginUI(); 
        });
      } else {
