  }

  /* Gaya Kartu Statistik Modern */
.card-stat-modern {
  border: none;
  border-radius: 12px;
  color: white;
  padding: 20px;
  position: relative;
  overflow: hidden;
  transition: transform 0.3s ease;
  box-shadow: 0 10px 20px rgba(0,0,0,0.05);
}

.card-stat-modern:hover {
  transform: translateY(-5px);
}

/* Variasi Warna Gradien */
.bg-grad-indigo { background: linear-gradient(45deg, #6366f1, #818cf8); }
.bg-grad-purple { background: linear-gradient(45deg, #a855f7, #c084fc); }
.bg-grad-teal   { background: linear-gradient(45deg, #14b8a6, #2dd4bf); }
.bg-grad-rose   { background: linear-gradient(45deg, #f43f5e, #fb7185); }

/* Ikon di dalam Kartu */
.icon-box-dash {
  position: absolute;
  right: -10px;
  bottom: -10px;
  font-size: 5rem;
  opacity: 0.2;
  transform: rotate(-15deg);
}

 .stat-label-modern {
      font-size: 0.65rem;
      font-weight: 700;
      letter-spacing: 0.1em;
      opacity: 0.8;
    }
    .stat-value-modern {
      font-size: 1.75rem;
      font-weight: 700;
      letter-spacing: -0.03em;
    }

/* Container Chart */
.chart-container-modern {
  background: white;
  border-radius: 12px;
  padding: 20px;
  border: 1px solid #f1f5f9;
  box-shadow: 0 4px 15px rgba(160, 174, 192, 0.05);
}

/* Container Upload Mewah */
.upload-area {
    border: 2px dashed #e2e8f0;
    border-radius: var(--radius-md);
    padding: 25px;
    text-align: center;
    background: #f8fafc;
    cursor: pointer;
    transition: all 0.3s ease;
    position: relative;
    overflow: hidden;
}

.upload-area:hover, .upload-area.dragover {
    border-color: var(--primary);
    background: #f5f3ff;
}

.upload-area i {
    font-size: 2.5rem;
    color: var(--primary);
    margin-bottom: 10px;
    display: block;
}

.upload-area p {
    margin: 0;
    font-size: 0.9rem;
    color: #64748b;
}

.upload-area .file-info {
    display: none;
    font-weight: 600;
    color: var(--primary);
    margin-top: 10px;
}

/* Sembunyikan input asli */
#fileInput {
    display: none;
}

/* Container Profil Utama */
.user-profile-wrapper {
    display: flex;
    align-items: center;
    gap: 15px;
    padding: 8px 16px;
    border-radius: 12px;
    cursor: pointer;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    background: transparent;
}

.user-profile-wrapper:hover {
    background: rgba(99, 102, 241, 0.08); /* Indigo sangat tipis */
}

/* Teks Selamat Datang */
.greeting-text {
    text-align: right;
    line-height: 1.2;
}

.greeting-text .welcome {
    display: block;
    font-size: 0.7rem;
    font-weight: 600;
    color: #94a3b8;
    text-transform: uppercase;
    letter-spacing: 0.5px;
}

.greeting-text .user-fullname {
    display: block;
    font-size: 0.95rem;
    font-weight: 700;
    color: #1e293b;
}

/* Avatar Bulat dengan Animasi */
.avatar-container {
    position: relative;
}

.avatar-circle-lux {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    object-fit: cover;
    border: 2px solid white;
    box-shadow: 0 4px 10px rgba(99, 102, 241, 0.2);
    transition: all 0.4s ease;
}

.user-profile-wrapper:hover .avatar-circle-lux {
    transform: scale(1.1) rotate(5deg);
