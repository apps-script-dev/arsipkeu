function updateDropdowns(data) {
    let optionsUpload = ""; 
    let optionsFilter = '<option value="">Semua Kategori</option>'; 

    for(let i = 1; i < data.length; i++) {
      const catName = data[i][0];
      const opt = `<option value="${catName}">${catName}</option>`;
      optionsUpload += opt;
      optionsFilter += opt;
    }

    // Update Dropdown Modal & Filter
    if ($('#category').data('select2')) $('#category').select2('destroy');
    if ($('#filterCategory').data('select2')) $('#filterCategory').select2('destroy');

    document.getElementById('category').innerHTML = optionsUpload;
    document.getElementById('filterCategory').innerHTML = optionsFilter;

    // Re-init Select2
    initSelect2();
}

