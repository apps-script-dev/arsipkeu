    // Pindahkan dropdown 'Tampil x' ke dalam div catLengthPlacement
    $('#catLengthPlacement').empty();
    $('#catDataTable_wrapper .dataTables_length').appendTo('#catLengthPlacement');

    // Penomoran otomatis
    catDataTableInstance.on('draw.dt', function () {
      let n = 1;
      catDataTableInstance.column(0, {search:'applied', order:'applied'}).nodes().each(function (cell) {
        cell.innerHTML = n++;
      });
    }).draw();

    // Re-bind pencarian custom
    const si = $('#catSearchInputCustom');
