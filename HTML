function showResetPasswordForm(token) {
  // 1. Siapkan tampilan latar belakang (Login Page)
  const loginPage = document.getElementById('loginPage');
  const loginForm = document.getElementById('loginForm');
  const registerForm = document.getElementById('registerForm');
  
  if (loginPage) loginPage.style.display = 'flex';
  if (loginForm) loginForm.classList.add('d-none'); // Sembunyikan form login dulu
  if (registerForm) registerForm.classList.add('d-none');

  // 2. Munculkan Popup Ganti Password
  Swal.fire({
    title: 'Keamanan Akun',
    text: 'Silakan masukkan password baru Anda untuk memulihkan akses.',
    input: 'password',
    inputPlaceholder: 'Password baru',
    confirmButtonText: 'PERBARUI PASSWORD',
    confirmButtonColor: '#7c3aed',
    allowOutsideClick: false,
    showLoaderOnConfirm: true,
    preConfirm: (newPass) => {
      if (!newPass || newPass.length < 5) {
        return Swal.showValidationMessage('Password minimal 5 karakter!');
      }
      return new Promise((resolve) => {
        // Panggil fungsi di Code.gs
        google.script.run.withSuccessHandler(res => resolve(res)).finalizeResetPassword(token, newPass);
      });
    }
  }).then((result) => {
    if (result.isConfirmed) {
      if (result.value && result.value.success) {
        // --- JIKA BERHASIL ---
        Swal.fire({
          icon: 'success',
          title: 'Berhasil!',
          text: result.value.msg,
          confirmButtonText: 'MASUK SEKARANG',
          confirmButtonColor: '#7c3aed'
        }).then(() => {
          // A. Bersihkan URL dari parameter ?token=... agar tidak diminta reset lagi
          if (window.history.replaceState) {
            const cleanUrl = window.location.origin + window.location.pathname;
            window.history.replaceState({}, document.title, cleanUrl);
          }

          // B. Tampilkan kembali form Login secara manual (Anti-Blank)
          if (loginForm) loginForm.classList.remove('d-none');
          
          // C. Panggil fungsi inisialisasi login agar UI bersih
          showLoginUI(); 
        });
      } else {
        // --- JIKA GAGAL (Token Expired, dll) ---
        Swal.fire('Gagal', result.value ? result.value.msg : 'Terjadi kesalahan sistem', 'error').then(() => {
           // Balikkan ke login jika token salah
           location.reload(); 
        });
      }
    }
  });
}

