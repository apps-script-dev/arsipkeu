          searchInput.off('keyup').on('keyup', function() {
            utable.search(this.value).draw();
            this.value.length > 0 ? clearBtn.show() : clearBtn.hide();
          });

          clearBtn.off('click').on('click', function() {
            searchInput.val('');
            $(this).hide();
            utable.search('').draw();
            searchInput.focus();
          });

        } else {
          tbody.innerHTML = '<tr><td colspan="5" class="text-center p-5 text-muted">Belum ada user terdaftar.</td></tr>';
        }
      } catch (err) {
        console.error("Render Error:", err);
      }
    }).getAllUsers();

  } catch (err) {
    console.error("Critical Error loadUserTable:", err);
    // Jika terjadi error parah, pastikan loader hilang
    const loader = document.getElementById('loadingOverlay');
    if (loader) loader.style.display = 'none';
  }
}

function saveNewUser() {
  // 1. Ambil elemen dan nilai input
  const fullNameEl = document.getElementById('newFullName');
  const emailEl = document.getElementById('newEmail');
  const userEl = document.getElementById('newUsername');
  const passEl = document.getElementById('newPassword');
  const btn = document.getElementById('btnSaveUser');

  const fullName = fullNameEl ? fullNameEl.value.trim() : "";
  const email = emailEl ? emailEl.value.trim().toLowerCase() : "";
  const username = userEl ? userEl.value.trim() : "";
  const password = passEl ? passEl.value : "";

  // 2. Validasi Kelengkapan (Popup Mewah & Kompak)
  if (!fullName || !email || !username || !password) {
    return Swal.fire({
      title: 'Data Tidak Lengkap',
      text: 'Semua kolom wajib diisi untuk mendaftarkan user baru.',
      iconHtml: '<i class="bi bi-exclamation-triangle-fill text-warning" style="font-size: 2.5rem;"></i>',
      confirmButtonText: 'LENGKAPI',
      confirmButtonColor: '#7c3aed',
      showClass: { popup: 'animate__animated animate__shakeX' },
      customClass: { icon: 'border-0' }
    });
  }

  // 3. Validasi Khusus Email Google
  if (!email.endsWith('@gmail.com')) {
    return Swal.fire({
      title: 'Email Ditolak',
      text: 'User baru wajib menggunakan alamat @gmail.com!',
      iconHtml: '<i class="bi bi-envelope-x-fill text-danger" style="font-size: 2.5rem;"></i>',
      confirmButtonText: 'PERBAIKI EMAIL',
      confirmButtonColor: '#ef4444',
      customClass: { icon: 'border-0' }
    });
  }

  // 4. Visual Feedback pada Tombol (Teks Tetap Putih)
  btn.disabled = true;
  btn.innerHTML = `
    <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
    <span style="color: white !important; margin-left: 8px; font-weight: 700;">PROSES SIMPAN...</span>
  `;

  const userData = {
    fullName: fullName,
    email: email,
    username: username,
    password: password
  };

  // 5. Kirim data ke Server
  google.script.run.withSuccessHandler(res => {
    // Kembalikan tombol ke kondisi semula
    btn.disabled = false;
    btn.innerText = 'SIMPAN USER';
    
    if (res.success) {
      // --- POPUP BERHASIL (Compact & Modern) ---
      Swal.fire({
        title: 'Berhasil!',
        text: 'User baru telah ditambahkan ke database.',
        iconHtml: '<i class="bi bi-check-lg"></i>',
        showConfirmButton: false,
        timer: 2000,
        timerProgressBar: true,
        customClass: { icon: 'border-success' },
        showClass: { popup: 'animate__animated animate__fadeInUp animate__faster' }
      }).then(() => {
        // Bersihkan form input
        if (fullNameEl) fullNameEl.value = "";
        if (emailEl) emailEl.value = "";
        if (userEl) userEl.value = "";
        if (passEl) passEl.value = "";
        
        // Refresh tabel user
        if (typeof loadUserTable === 'function') {
          loadUserTable();
        }
      });
    } else {
      // --- POPUP GAGAL (Contoh: Username sudah ada) ---
      Swal.fire({
        title: 'Gagal Simpan',
        text: res.msg,
        iconHtml: '<i class="bi bi-x-circle-fill text-danger" style="font-size: 2.5rem;"></i>',
        confirmButtonText: 'PERBAIKI',
        confirmButtonColor: '#ef4444',
        customClass: { icon: 'border-0' }
      });
    }
  }).registerUser(userData);
}

function delUser(username) {
  // 1. Popup Konfirmasi Hapus Mewah
  Swal.fire({
    title: 'Hapus Pengguna?',
    html: `Apakah Anda yakin ingin menghapus akun <b>${username}</b>?<br><small class="text-danger">Tindakan ini permanen dan tidak bisa dibatalkan.</small>`,
    // Ikon Tong Sampah Merah Mewah
    iconHtml: '<i class="bi bi-trash3-fill text-danger" style="font-size: 3rem;"></i>',
    showCancelButton: true,
    confirmButtonText: 'YA, HAPUS',
    cancelButtonText: 'BATAL',
    confirmButtonColor: '#ef4444', // Merah Solid
    cancelButtonColor: '#64748b',  // Abu-abu Slate
    reverseButtons: true,         // Tombol Batal di kiri, Hapus di kanan
    showLoaderOnConfirm: true,    // AKTIFKAN LOADING SAAT DIKLIK
    allowOutsideClick: () => !Swal.isLoading(),
    customClass: {
      icon: 'border-0' // Hilangkan border lingkaran default
    },
    // 2. Logika Penghapusan saat tombol diklik
    preConfirm: () => {
      return new Promise((resolve) => {
        google.script.run
          .withSuccessHandler((response) => {
            resolve(response); // Berhasil di server
          })
          .withFailureHandler((err) => {
            Swal.showValidationMessage(`Gagal: ${err}`);
            resolve(null);
          })
          .deleteUser(username); // Memanggil fungsi di Code.gs
      });
    }
  }).then((result) => {
    // 3. Popup Sukses Setelah Server Selesai
    if (result.isConfirmed && result.value) {
      Swal.fire({
        title: 'User Terhapus',
        text: `Akun ${username} telah berhasil dibuang dari database.`,
        iconHtml: '<i class="bi bi-check-lg"></i>',
        timer: 2000,
        showConfirmButton: false,
        timerProgressBar: true,
        customClass: { icon: 'border-success' }
      }).then(() => {
        // Refresh tabel user agar perubahan terlihat
        if (typeof loadUserTable === 'function') {
            loadUserTable();
        }
      });
    }
  });
}

