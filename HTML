function forgotPassword() {
  Swal.fire({
    title: 'Lupa Password?',
    text: "Masukkan Username Anda, kami akan mengirimkan link reset ke email yang terdaftar.",
    input: 'text',
    inputPlaceholder: 'Username Anda',
    showCancelButton: true,
    confirmButtonText: 'KIRIM LINK',
    cancelButtonText: 'BATAL',
    confirmButtonColor: '#6366f1',
    cancelButtonColor: '#94a3b8',
    showLoaderOnConfirm: true,
    reverseButtons: true,
    allowOutsideClick: () => !Swal.isLoading(),
    preConfirm: (username) => {
      if (!username) return Swal.showValidationMessage('Mohon masukkan username Anda!');
      
      return new Promise((resolve) => {
        google.script.run
          .withSuccessHandler((res) => {
            resolve(res);
          })
          .withFailureHandler((err) => {
            Swal.showValidationMessage(`Koneksi Gagal: ${err}`);
            resolve({ success: false, msg: "Gagal terhubung ke server." });
          })
          .processForgotPassword(username);
      });
    },
    customClass: {
        popup: 'swal2-luxury-border'
    }
  }).then((result) => {
    if (result.isConfirmed && result.value) {
      if (result.value.success) {
        // Pop-up Sukses Mewah
        Swal.fire({
          title: 'Email Terkirim!',
          text: result.value.msg,
          iconHtml: '<i class="bi bi-check-lg text-success" style="font-size: 3rem;"></i>',
          timer: 6000,
          timerProgressBar: true,
          showConfirmButton: false,
          customClass: { icon: 'border-success', popup: 'no-btn' }
        });
      } else {
        // Pop-up Gagal
        Swal.fire({
          title: 'Gagal Mengirim',
          text: result.value.msg,
          iconHtml: '<i class="bi bi-x-circle-fill text-danger" style="font-size: 3rem;"></i>',
          confirmButtonText: 'COBA LAGI',
          confirmButtonColor: '#ef4444',
          customClass: { icon: 'border-0' }
        });
      }
    }
  });
}
