function doLogin() {
  const u = document.getElementById('user').value;
  const p = document.getElementById('pass').value;
  const rememberCheckbox = document.getElementById('remember');
  const isRemember = rememberCheckbox ? rememberCheckbox.checked : false;

  // Validasi Input Kosong
  if (!u || !p) {
    return Swal.fire({
      icon: 'warning',
      title: 'Akses Ditolak',
      text: 'Username dan Password wajib diisi untuk masuk ke sistem.',
      confirmButtonText: 'MENGERTI',
      showClass: { popup: 'animate__animated animate__shakeX' }
    });
  }

  // Loading Otentikasi
  Swal.fire({
    title: 'Otentikasi...',
    text: 'Sedang memverifikasi kredensial Anda',
    allowOutsideClick: false,
    didOpen: () => { Swal.showLoading(); }
  });

  google.script.run.withSuccessHandler(res => {
    Swal.close();
    if (res && res.success) {
      // --- LOGIKA REMEMBER ME ---
      if (isRemember) {
        localStorage.setItem('remembered_username', u);
      } else {
        localStorage.removeItem('remembered_username');
      }

      // Notifikasi Sukses
      Swal.fire({
        icon: 'success',
        title: 'Login Berhasil!',
        text: `Selamat datang kembali, ${res.user}`,
        timer: 2000,
        showConfirmButton: false,
        timerProgressBar: true,
      }).then(() => {
        localStorage.setItem('archive_session', JSON.stringify(res));
        showAppUI(res);
      });
    } else {
      Swal.fire({
        icon: 'error',
        title: 'Gagal Masuk',
        text: 'Username atau Password yang Anda masukkan salah.',
        confirmButtonText: 'COBA LAGI'
      });
