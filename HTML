function renderMainChart(stats, filter) {
    const barContainer = document.getElementById('chart3DContainer');
    const gridContainer = document.getElementById('gridLines');
    const yAxisContainer = document.getElementById('yAxisLabels');

    barContainer.innerHTML = "";
    gridContainer.innerHTML = "";
    yAxisContainer.innerHTML = "";

    let labels = [];
    let values = [];

    if (filter === 'year') {
        labels = ['JAN','FEB','MAR','APR','MEI','JUN','JUL','AGU','SEP','OKT','NOV','DES'];
        values = stats.monthly;
    } else if (filter === 'month') {
        const now = new Date();
        const daysInMonth = new Date(now.getFullYear(), now.getMonth() + 1, 0).getDate();
        for (let d = 1; d <= daysInMonth; d++) {
            labels.push(d);
            values.push(stats.daily[d] || 0);
        }
    } else if (filter === 'week') {
        // --- LOGIKA MINGGU INI ---
        labels = ['SEN', 'SEL', 'RAB', 'KAM', 'JUM', 'SAB', 'MIN'];
        values = stats.weekly;
    }

    // 1. Tentukan Skala Maksimal (Sumbu Y)
    const maxValueReal = Math.max(...values);
    const maxValue = maxValueReal < 5 ? 5 : Math.ceil(maxValueReal * 1.2); 

    // 2. Buat Grid Lines & Label Y
    const step = Math.ceil(maxValue / 5);
    for (let i = 0; i <= maxValue; i += step) {
        const line = document.createElement('div');
        line.className = 'grid-line';
        gridContainer.appendChild(line);

        const label = document.createElement('div');
        label.innerText = i;
        yAxisContainer.appendChild(label);
    }

    // 3. Render Batang 3D
    values.forEach((val, index) => {
        const heightPct = (val / maxValue) * 100;
        const minHeightPct = 4;
        
        // Atur lebar batang: Mingguan (7 batang) bisa lebih lebar agar terlihat mewah
        let barWidth = "70%";
        if(filter === 'month') barWidth = "85%";
        if(filter === 'week') barWidth = "50%"; // Lebih proporsional untuk 7 batang

        const barItem = document.createElement('div');
        barItem.className = 'cyl-bar-item flex-grow-1 d-flex flex-column align-items-center justify-content-end';
        barItem.style.height = "100%";
        
        barItem.innerHTML = `
            <div class="cyl-bar-container cyl-color-purple" style="height: ${val === 0 ? minHeightPct : heightPct}%; width: ${barWidth};" title="${labels[index]}: ${val} Dokumen">
                <div class="cyl-bar-top">${val > 0 ? val : ''}</div>
                <div class="cyl-bar-body" style="height: 100%;"></div>
                <div class="cyl-bar-base"></div>
            </div>
            <div class="cyl-bar-label" style="margin-top:15px; font-size: 8px;">${labels[index]}</div>
        `;
        
        barContainer.appendChild(barItem);
    });
}

