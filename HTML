  }).withFailureHandler(() => {
    Swal.close();
    Swal.fire({
      icon: 'error',
      title: 'Koneksi Gagal',
      text: 'Gagal terhubung ke server. Periksa koneksi internet Anda.',
      confirmButtonText: 'OK'
    });
  }).checkLogin(u, p);
}

    function typeWriter(text, elementId, speed = 100) {
  const element = document.getElementById(elementId);
  element.innerText = ""; // Bersihkan teks awal
  let i = 0;

  function type() {
    if (i < text.length) {
      element.innerText += text.charAt(i);
      i++;
      setTimeout(type, speed);
    }
  }
  type();
}

