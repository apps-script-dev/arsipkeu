    /* Alas bawah lebih pekat */
    background: #7c3aed !important;
    filter: brightness(0.9);
}

/* Tambahan: Animasi halus saat hover */
.cyl-bar-container {
    transition: all 0.4s cubic-bezier(0.165, 0.84, 0.44, 1);
}

.cyl-bar-container:hover .cyl-bar-top {
    background: #f5f3ff !important; /* Lebih putih saat disorot */
}

