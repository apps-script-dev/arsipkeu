/* --- ANIMASI ICON SUCCESS MEWAH --- */

.swal2-icon.swal2-success {
    border: 2px solid #22c55e !important;
    display: flex !important;
    align-items: center;
    justify-content: center;
    position: relative;
    /* Animasi lingkaran muncul */
    animation: swal-bounce-in 0.5s i; 
}

/* Lingkaran halus di belakang icon (efek Pulse) */
.swal2-icon.swal2-success::after {
    content: '';
    position: absolute;
    width: 100%;
    height: 100%;
    border-radius: 50%;
    border: 2px solid #22c55e;
    animation: swal-pulse-ring 1.5s infinite;
    display: block !important; /* Pastikan muncul */
}

/* Ikon centang di dalam */
.swal2-icon.swal2-success .bi-check-lg {
    font-size: 2.2rem !important;
    color: #22c55e !important;
    display: block !important;
    /* Animasi centang muncul */
    animation: swal-tick-pop 0.6s cubic-bezier(0.175, 0.885, 0.32, 1.275) forwards;
}

/* --- FIX TOMBOL BATAL SAAT LOADING --- */

/* Sembunyikan tombol konfirmasi DAN tombol batal secara total saat status LOADING aktif */
.swal2-loading .swal2-confirm,
.swal2-loading .swal2-cancel {
    display: none !important;
}

/* Pastikan wadah tombol tetap ada untuk spinner, tapi tombol di dalamnya hilang */
.swal2-loading .swal2-actions {
    background: transparent !important;
}

/* Mempercantik spinner agar tepat di tengah */
.swal2-loader {
    margin: 15px auto !important;
    border-color: #6366f1 transparent #6366f1 transparent !important; /* Warna Ungu Indigo */
}

/* --- FIX TOTAL ICON ERROR (ANTI-PECAH) --- */

/* 1. Sembunyikan garis animasi bawaan 'X' yang berantakan */
.swal2-icon.swal2-error [class^='swal2-x-mark'] {
    display: none !important;
}

/* 2. Atur wadah Icon Error agar bersih dan simetris */
.swal2-icon.swal2-error {
    border: 2px solid #ef4444 !important; /* Garis merah elegan */
    background-color: transparent !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    width: 60px !important;
    height: 60px !important;
    margin: 1rem auto 0 !important;
}

/* 3. Masukkan Icon X dari Bootstrap secara paksa jika dipanggil via CSS */
.swal2-icon.swal2-error::before {
    content: '\F62A'; /* Kode Unicode Ikon bi-x-lg */
    font-family: 'bootstrap-icons' !important;
    font-size: 2rem !important;
    color: #ef4444 !important;
    font-weight: 900 !important;
    display: block !important;
}

/* Tambahan: Animasi getar halus saat muncul (Mewah) */
.swal2-icon.swal2-error {
    animation: swal-error-shake 0.5s ease-in-out;
}

@keyframes swal-error-shake {
    0%, 100% { transform: translateX(0); }
    25% { transform: translateX(-5px); }
    75% { transform: translateX(5px); }
}

/* KEYFRAMES ANIMASI */

/* Efek Membal (Bounce) untuk lingkaran */
@keyframes swal-bounce-in {
    0% { transform: scale(0.3); opacity: 0; }
    50% { transform: scale(1.05); opacity: 1; }
    70% { transform: scale(0.9); }
    100% { transform: scale(1); }
}

/* Efek Pop-in untuk centang */
@keyframes swal-tick-pop {
    0% { transform: scale(0) rotate(-45deg); opacity: 0; }
    100% { transform: scale(1) rotate(0deg); opacity: 1; }
}

/* Efek Gelombang (Pulse) melingkar */
@keyframes swal-pulse-ring {
    0% { transform: scale(1); opacity: 0.5; }
    100% { transform: scale(1.4); opacity: 0; }
}

.swal2-icon.swal2-success [class^='swal2-success-line'],
