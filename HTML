        // Bersihkan Semua Form
        document.getElementById('regFullName').value = "";
        document.getElementById('regEmail').value = "";
        document.getElementById('regUser').value = "";
        document.getElementById('regPass').value = "";
        
        // Alihkan ke halaman login
        toggleAuth(false);
      });
    } else {
      Swal.fire({
        icon: 'error',
        title: 'Registrasi Gagal',
        text: res.msg,
        confirmButtonText: 'PERBAIKI'
      });
    }
  }).registerUser(userData);
}

function openUserManagement() {
  // 1. Masuk ke tab Pengaturan utama
  switchTab('settings');

  // 2. Cari tombol navigasi sub-tab 'User Manajemen'
  const userTabTrigger = document.querySelector('button[data-bs-target="#sub-users"]');
  
  if (userTabTrigger) {
    // 3. Gunakan API Bootstrap untuk menampilkan tab tersebut
    const tab = new bootstrap.Tab(userTabTrigger);
    tab.show();
    
    // 4. Pastikan data user dimuat ulang
    loadUserTable();
  }
}

function forgotPassword() {
  Swal.fire({
    title: 'Lupa Password?',
    text: "Masukkan Username Anda, link tautan untuk mengganti password akan dikirim melalui email anda yang terdaftar.",
    input: 'text',
    inputPlaceholder: 'Username Anda',
    inputAttributes: { autocapitalize: 'off' },
    showCancelButton: true,
    confirmButtonText: 'KIRIM PASSWORD',
    cancelButtonText: 'BATAL',
    showLoaderOnConfirm: true,
    confirmButtonColor: '#7c3aed',
    preConfirm: (username) => {
      if (!username) return Swal.showValidationMessage('Username wajib diisi!');
      return new Promise((resolve) => {
        // Memanggil fungsi di Code.gs (Pastikan sudah Anda buat di file Code.gs)
        google.script.run.withSuccessHandler(res => {
          resolve(res);
        }).processForgotPassword(username);
      });
    },
    allowOutsideClick: () => !Swal.isLoading()
  }).then((result) => {
    if (result.isConfirmed) {
      if (result.value.success) {
        Swal.fire('Berhasil!', result.value.msg, 'success');
      } else {
        Swal.fire('Gagal', result.value.msg, 'error');
      }
    }
  });
}
  </script>
