      dataTableInstance.column(5).search(term, true, false).draw();
    }
  }
}

function uploadArsip() {
    const n = document.getElementById('docName').value;
    const num = document.getElementById('docNumber').value;
    const dDate = document.getElementById('docDate').value;
    const btn = document.getElementById('btnSave');

    if(!selectedFileBlob || !n || !num || !dDate) return Swal.fire('Error', 'Lengkapi data dan file!', 'warning');

    btn.disabled = true; 
    // Kita bungkus teks di dalam span dengan warna putih eksplisit
    btn.innerHTML = `
      <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
      <span style="color: white !important; margin-left: 8px; font-weight: 700;">MENYIMPAN KE DATABASE..</span>
    `;
    
    const r = new FileReader();
    r.onload = function(e) {
        const session = JSON.parse(localStorage.getItem('archive_session'));
        const p = {
            docName: n,
            docNumber: num,
            docDate: dDate,
            inputDate: document.getElementById('inputDate').value,
            category: document.getElementById('category').value,
            fileName: selectedFileName,
            fileType: selectedFileType,
            fileData: e.target.result.split(',')[1],
            user: session ? session.user : "System"
        };
        
        google.script.run.withSuccessHandler(() => {
            Swal.fire({
              // icon: 'success', <-- JANGAN PAKAI INI (Hapus baris ini)
              iconHtml: '<i class="bi bi-check-lg"></i>', // Gunakan ini saja
              title: 'Berhasil!',
              text: 'Data telah disimpan.',
              timer: 2000,
              showConfirmButton: false,
              timerProgressBar: true,
              customClass: {
                icon: 'border-success' // Menyesuaikan dengan CSS kita
              }
            });
            bootstrap.Modal.getInstance(document.getElementById('modalAdd')).hide();
            resetForm();
