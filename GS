function getDashboardData() {
  try {
    const sheet = SpreadsheetApp.openById(SPREADSHEET_ID).getSheetByName("Archives");
    const data = sheet.getDataRange().getValues();
    const now = new Date();
    
    // Tentukan awal minggu (Senin)
    const day = now.getDay();
    const diffToMonday = now.getDate() - day + (day === 0 ? -6 : 1); 
    const startOfWeek = new Date(now.setDate(diffToMonday));
    startOfWeek.setHours(0,0,0,0);
    
    const endOfWeek = new Date(startOfWeek);
    endOfWeek.setDate(startOfWeek.getDate() + 6);
    endOfWeek.setHours(23,59,59,999);

    let stats = { 
      total: 0, 
      categories: {}, 
      monthly: Array(12).fill(0),
      daily: Array(32).fill(0),
      weekly: Array(7).fill(0) // Indeks 0=Senin, ..., 6=Minggu
    };

    if (data.length > 1) {
      stats.total = data.length - 1;
      for (let i = 1; i < data.length; i++) {
        let cat = data[i][4] || "Lainnya"; 
        stats.categories[cat] = (stats.categories[cat] || 0) + 1;

        let date = new Date(data[i][3]);
        if (!isNaN(date.getTime())) {
          // 1. Tahun/Bulan (Seperti sebelumnya)
          stats.monthly[date.getMonth()] += 1;
          if (date.getMonth() === new Date().getMonth()) {
            stats.daily[date.getDate()] += 1;
          }

          // 2. LOGIKA MINGGU INI (Senin-Minggu)
          if (date >= startOfWeek && date <= endOfWeek) {
            let dayIndex = date.getDay(); // 0=Minggu, 1=Senin...
            let adjustedIndex = (dayIndex === 0) ? 6 : dayIndex - 1; // Ubah ke 0=Senin...6=Minggu
            stats.weekly[adjustedIndex] += 1;
          }
        }
      }
    }
    return stats;
  } catch(e) {
    return { total: 0, categories: {}, monthly: Array(12).fill(0), daily: Array(32).fill(0), weekly: Array(7).fill(0) };
  }
}

// FUNGSI INI YANG DIPERBAIKI (Gunakan getDisplayValues)
function getArchives() {
  try {
    const ss = SpreadsheetApp.openById(SPREADSHEET_ID);
    const sheet = ss.getSheetByName("Archives");
    if (!sheet) return "Error: Nama Sheet salah";
    
    // Mengambil data sebagai teks (Display Values) agar tidak error saat dikirim ke browser
    const values = sheet.getDataRange().getDisplayValues();
    return values; 
  } catch (e) {
    return "Error: " + e.toString();
  }
}

function saveArchive(p) {
  try {
    const folder = DriveApp.getFolderById(FOLDER_ID);
    const blob = Utilities.newBlob(Utilities.base64Decode(p.fileData), p.fileType, p.fileName);
    
    // HITUNG UKURAN FILE (Bytes ke MB)
    const sizeInBytes = blob.getBytes().length;
    const sizeInMB = (sizeInBytes / (1024 * 1024)).toFixed(2); // Ambil 2 angka di belakang koma

    const file = folder.createFile(blob);
    file.setSharing(DriveApp.Access.ANYONE_WITH_LINK, DriveApp.Permission.VIEW);
    
    const sheet = SpreadsheetApp.getActiveSpreadsheet().getSheetByName("Archives");
    
    // Urutan Kolom: [0]ID, [1]Nama, [2]No, [3]TglDok, [4]Kat, [5]TglInput, [6]Link, [7]Uploader, [8]SizeMB
    sheet.appendRow([
      "ARC-" + Date.now(), 
      p.docName, 
      p.docNumber,
      p.docDate,
      p.category, 
      p.inputDate,
      file.getUrl(), 
      p.user,
      sizeInMB // Data baru
    ]);
    return "Sukses";
  } catch (e) {
    return "Gagal: " + e.message;
  }
}

function deleteArchive(id) {
  try {
    const ss = SpreadsheetApp.openById(SPREADSHEET_ID);
    const sheet = ss.getSheetByName("Archives");
    const data = sheet.getDataRange().getValues();
    
    for (let i = 1; i < data.length; i++) {
      if (data[i][0] === id) {
        // Ambil URL file dari kolom G (index 6)
        const fileUrl = data[i][6];
        
        // 1. Logika Hapus File di Google Drive
        if (fileUrl && fileUrl !== "#") {
          try {
            // Ekstrak ID file dari URL Drive
            const fileId = fileUrl.match(/[-\w]{25,}/);
            if (fileId) {
              DriveApp.getFileById(fileId[0]).setTrashed(true); // Pindah ke Trash (aman)
              // Jika ingin hapus permanen: Drive.Files.remove(fileId[0]); (perlu API khusus)
            }
          } catch (e) {
            console.error("Gagal menghapus file di Drive: " + e.message);
          }
        }
        
        // 2. Hapus baris di Google Sheets
        sheet.deleteRow(i + 1);
        return "Berhasil dihapus dari Database dan Drive";
      }
    }
    return "Data tidak ditemukan";
  } catch (e) {
    return "Error: " + e.toString();
  }
}

