function registerUser(userData) {
  try {
    const sheet = SpreadsheetApp.openById(SPREADSHEET_ID).getSheetByName("Users");
    const data = sheet.getDataRange().getValues();
    
    // Cek duplikasi username (Kolom A)
    for (let i = 1; i < data.length; i++) {
      if (data[i][0].toString() === userData.username) {
        return { success: false, msg: "Username sudah digunakan!" };
      }
      // Cek duplikasi email (Kolom E)
      if (data[i][4] && data[i][4].toString() === userData.email) {
        return { success: false, msg: "Email sudah terdaftar!" };
      }
    }
    
    const defaultAvatar = `https://ui-avatars.com/api/?name=${encodeURIComponent(userData.fullName)}&background=6366f1&color=fff&rounded=true`;
    
    // Simpan data (Urutan: Username, Password, Nama, Avatar, Email)
    // Pastikan di Google Sheets kolom E adalah Email
    sheet.appendRow([
      userData.username, 
      userData.password, 
      userData.fullName, 
      defaultAvatar,
      userData.email
    ]);
    
    return { success: true, msg: "Akun Google Anda berhasil didaftarkan!" };
  } catch (e) {
    return { success: false, msg: "Terjadi kesalahan: " + e.message };
  }
}

function getRecentActivity() {
  try {
    const ss = SpreadsheetApp.openById(SPREADSHEET_ID);
    const sheet = ss.getSheetByName("Archives");
    if (!sheet) return [];
    
    // Ambil semua data sebagai teks yang terlihat (Display Values)
    const data = sheet.getDataRange().getDisplayValues(); 
    if (data.length <= 1) return [];
    
    // Ambil data tanpa header, balik urutan (terbaru di atas), ambil 5 teratas
    const recentData = data.slice(1).reverse().slice(0, 5);
    return recentData;
  } catch (e) {
    console.error("Error getRecentActivity: " + e.message);
    return [];
  }
}

function processForgotPassword(username) {
  try {
    const ss = SpreadsheetApp.openById(SPREADSHEET_ID);
    const sheet = ss.getSheetByName("Users");
    const data = sheet.getDataRange().getValues();
    
    // Ambil URL Web App Anda secara otomatis
    const webAppUrl = ScriptApp.getService().getUrl();

    for (let i = 1; i < data.length; i++) {
      if (data[i][0].toString() === username) {
        const userEmail = data[i][4]; // Kolom E
        if (!userEmail) return { success: false, msg: "Email tidak terdaftar." };

        // Buat Token unik
        const token = Utilities.base64Encode(Math.random().toString() + Date.now());
        
        // Simpan token ke kolom F (Index 5)
        sheet.getRange(i + 1, 6).setValue(token);

        // Buat Link Reset
        const webAppUrl = ScriptApp.getService().getUrl().replace(/\/dev$/, "/exec");
        const resetLink = webAppUrl + "?token=" + token;

        // Kirim Email
        MailApp.sendEmail({
          to: userEmail,
          subject: "Atur Ulang Password - E-Archive Pro",
          htmlBody: `
            <div style="font-family: 'Inter', sans-serif; padding: 30px; background-color: #f8fafc; border-radius: 15px;">
              <h2 style="color: #7c3aed; margin-bottom: 20px;">Permintaan Atur Ulang Password</h2>
              <p>Halo, <strong>${data[i][2]}</strong>.</p>
              <p>Kami menerima permintaan untuk mengatur ulang password akun Anda. Silakan klik tombol di bawah ini untuk melanjutkan:</p>
              <div style="text-align: center; margin: 30px 0;">
                <a href="${resetLink}" style="background-color: #7c3aed; color: white; padding: 14px 30px; text-decoration: none; border-radius: 8px; font-weight: bold; display: inline-block;">ATUR ULANG PASSWORD</a>
              </div>
              <p style="font-size: 12px; color: #94a3b8;">Jika tombol tidak berfungsi, salin link berikut ke browser Anda:</p>
              <p style="font-size: 11px; color: #6366f1;">${resetLink}</p>
              <hr style="border: none; border-top: 1px solid #e2e8f0; margin: 20px 0;">
              <p style="font-size: 12px; color: #94a3b8;">Abaikan email ini jika Anda tidak merasa melakukan permintaan ini.</p>
            </div>
          `
        });
        
        return { success: true, msg: "Link pemulihan telah dikirim ke email Google Anda." };
      }
    }
    return { success: false, msg: "Username tidak ditemukan." };
  } catch (e) {
    return { success: false, msg: "Error: " + e.toString() };
  }
}

function finalizeResetPassword(token, newPass) {
  try {
    const ss = SpreadsheetApp.openById(SPREADSHEET_ID);
    const sheet = ss.getSheetByName("Users");
    const data = sheet.getRange("F:F").getValues(); // Cek di kolom ResetToken

    for (let i = 1; i < data.length; i++) {
      if (data[i][0] === token && token !== "") {
        // Update Password (Kolom B / Index 2)
        sheet.getRange(i + 1, 2).setValue(newPass);
        // Hapus token agar tidak bisa dipakai lagi (Kolom F / Index 6)
        sheet.getRange(i + 1, 6).setValue("");
        return { success: true, msg: "Password berhasil diperbarui! Silakan Login." };
      }
    }
    return { success: false, msg: "Link kadaluwarsa atau tidak valid." };
  } catch (e) {
    return { success: false, msg: e.toString() };
  }
}

